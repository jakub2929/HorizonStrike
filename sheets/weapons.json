{
  "sheet": "weapons",
  "version": 1,
  "key": "id",
  "desc": "Start loadout + buy wheel (D6: rows with buy_wheel_index >= 0, max 12). Bound cells: {\"cs2\": \"*\"} = the column bind template expanded with this row (generator), or an explicit {\"cs2\": \"<alias>:<key path>\"}; aliases in hooks.json (vdata = scripts/weapons.vdata_c, items = scripts/items/items_game.txt); Pair columns are CS2 [mode0, mode1] (mode1 = silencer on / scoped / burst); scalars normalize to [v, v]; a constant number in a bound column = n/a. Column default = value the game uses when the key is absent in CS2 data. Units: CS units (u), 1 u = 0.0254 m. Evidence: CS2 build 25815307, VRF CLI 20.0 decompile; display_name, buy_wheel_index, suspicion_radius_m are design (D5/D6/D9).",
  "columns": {
    "id": {"type": "string"},
    "display_name": {"type": "string", "desc": "English UI name (D9)"},
    "cs2_item": {"type": "string", "desc": "CS2 classname = block in weapons.vdata_c / item name in items_game"},
    "category": {"type": "enum", "values": ["knife", "pistol", "smg", "rifle", "sniper", "shotgun", "grenade", "equipment"], "desc": "from m_WeaponType"},
    "slot": {"type": "enum", "values": ["knife", "secondary", "primary", "grenade", "armor"], "desc": "from m_GearSlot (RIFLE->primary, PISTOL->secondary)"},
    "buy_wheel_index": {"type": "int", "desc": "0..11 wheel position (D6); -1 = not sold"},
    "start_loadout": {"type": "bool", "desc": "given at start and after every death (BRIEF)"},
    "suppressed": {"type": "bool", "desc": "D5; M4A1-S silencer is always on in v1"},
    "default_mode": {"type": "int", "desc": "index into pair columns used by default"},
    "price": {"type": "int", "from": "cs2", "bind": "vdata:{cs2_item}.m_nPrice", "desc": "USD"},
    "kill_award": {"type": "int", "from": "cs2", "bind": "vdata:{cs2_item}.m_nKillAward", "desc": "USD; D3 reward = kill_award x economy.kill_award_factor x machine.kill_reward_mult"},
    "kill_award_class": {"type": "ref", "ref": "systems", "desc": "HUD label + fallback award"},
    "damage": {"type": "number", "from": "cs2", "bind": "vdata:{cs2_item}.m_nDamage", "desc": "per bullet; molotov = per second"},
    "bullets": {"type": "int", "from": "cs2", "bind": "vdata:{cs2_item}.m_nNumBullets"},
    "headshot_mult": {"type": "number", "from": "cs2", "bind": "vdata:{cs2_item}.m_flHeadshotMultiplier", "desc": "weak-spot multiplier (D4)"},
    "armor_ratio": {"type": "number", "from": "cs2", "bind": "vdata:{cs2_item}.m_flArmorRatio", "desc": "CS armor rule, see systems combat.armor_*"},
    "penetration": {"type": "number", "from": "cs2", "bind": "vdata:{cs2_item}.m_flPenetration", "desc": "read, unused in v1 (no wall penetration)"},
    "range": {"type": "number", "from": "cs2", "bind": "vdata:{cs2_item}.m_flRange", "desc": "u; HE = blast radius"},
    "range_modifier": {"type": "number", "from": "cs2", "bind": "vdata:{cs2_item}.m_flRangeModifier", "desc": "dmg *= range_modifier^(dist_u/500)"},
    "full_auto": {"type": "bool", "from": "cs2", "bind": "vdata:{cs2_item}.m_bIsFullAuto"},
    "cycle_time": {"type": "list", "of": "number", "len": 2, "from": "cs2", "bind": "vdata:{cs2_item}.m_flCycleTime", "desc": "s between shots"},
    "clip_size": {"type": "int", "from": "cs2", "bind": "vdata:{cs2_item}.m_iMaxClip1"},
    "reserve_max": {"type": "int", "from": "cs2", "bind": "vdata:{cs2_item}.m_nPrimaryReserveAmmoMax", "desc": "magazines if reserve_as_clips, else rounds"},
    "reserve_as_clips": {"type": "bool", "from": "cs2", "bind": "vdata:{cs2_item}.m_bReserveAmmoAsClips", "default": false},
    "reload_time": {"type": "number", "from": "cs2", "bind": "vdata:{cs2_item}.m_flDisallowAttackAfterReloadStartDuration", "desc": "s (matches known CS reload times; per shell if reload_single_shells); cs2 cross-checks vs the reload clip length"},
    "reload_single_shells": {"type": "bool", "from": "cs2", "bind": "vdata:{cs2_item}.m_bReloadsSingleShells", "default": false},
    "deploy_time": {"type": "number", "from": "cs2", "bind": "vdata:{cs2_item}.m_flDeployDuration", "desc": "s"},
    "spread": {"type": "list", "of": "number", "len": 2, "from": "cs2", "bind": "vdata:{cs2_item}.m_flSpread"},
    "inaccuracy_stand": {"type": "list", "of": "number", "len": 2, "from": "cs2", "bind": "vdata:{cs2_item}.m_flInaccuracyStand"},
    "inaccuracy_crouch": {"type": "list", "of": "number", "len": 2, "from": "cs2", "bind": "vdata:{cs2_item}.m_flInaccuracyCrouch"},
    "inaccuracy_move": {"type": "list", "of": "number", "len": 2, "from": "cs2", "bind": "vdata:{cs2_item}.m_flInaccuracyMove"},
    "inaccuracy_jump": {"type": "list", "of": "number", "len": 2, "from": "cs2", "bind": "vdata:{cs2_item}.m_flInaccuracyJump"},
    "inaccuracy_land": {"type": "list", "of": "number", "len": 2, "from": "cs2", "bind": "vdata:{cs2_item}.m_flInaccuracyLand"},
    "inaccuracy_fire": {"type": "list", "of": "number", "len": 2, "from": "cs2", "bind": "vdata:{cs2_item}.m_flInaccuracyFire"},
    "recovery_time_stand": {"type": "number", "from": "cs2", "bind": "vdata:{cs2_item}.m_flRecoveryTimeStand"},
    "recovery_time_crouch": {"type": "number", "from": "cs2", "bind": "vdata:{cs2_item}.m_flRecoveryTimeCrouch"},
    "recoil_angle": {"type": "list", "of": "number", "len": 2, "from": "cs2", "bind": "vdata:{cs2_item}.m_flRecoilAngle"},
    "recoil_angle_variance": {"type": "list", "of": "number", "len": 2, "from": "cs2", "bind": "vdata:{cs2_item}.m_flRecoilAngleVariance"},
    "recoil_magnitude": {"type": "list", "of": "number", "len": 2, "from": "cs2", "bind": "vdata:{cs2_item}.m_flRecoilMagnitude"},
    "recoil_magnitude_variance": {"type": "list", "of": "number", "len": 2, "from": "cs2", "bind": "vdata:{cs2_item}.m_flRecoilMagnitudeVariance"},
    "recoil_seed": {"type": "int", "from": "cs2", "bind": "vdata:{cs2_item}.m_nRecoilSeed", "default": 0},
    "max_speed": {"type": "list", "of": "number", "len": 2, "from": "cs2", "bind": "vdata:{cs2_item}.m_flMaxSpeed", "desc": "u/s; player run speed with this item active"},
    "zoom_levels": {"type": "int", "from": "cs2", "bind": "vdata:{cs2_item}.m_nZoomLevels"},
    "zoom_fov": {"type": "int", "from": "cs2", "bind": "vdata:{cs2_item}.m_nZoomFOV1"},
    "throw_velocity": {"type": "number", "from": "cs2", "bind": "vdata:{cs2_item}.m_flThrowVelocity", "desc": "u/s", "default": 0},
    "armor_points": {"type": "int", "desc": "kevlar only; CS2 code constant, not in data"},
    "world_model": {"type": "string", "from": "cs2", "bind": "vdata:{cs2_item}.m_szWorldModel", "desc": "vmdl; also the weapon mesh of view.glb"},
    "view_anim_graph": {"type": "string", "desc": "AnimGraph2 graph in pak01 (clip list source); none = no viewmodel"},
    "view_anim_dir": {"type": "string", "desc": "vnmclip folder in pak01"},
    "icon": {"type": "string", "desc": "buy-wheel/HUD icon, vsvg_c -> svg"},
    "snd_shoot": {"type": "string", "desc": "= vdata m_aShootSounds.WEAPON_SOUND_SINGLE (SPECIAL1 for the silenced M4A1-S); none for knife/grenades/armor"},
    "snd_events": {"type": "list", "of": "string", "desc": "other soundevents (game_sounds_weapons.vsndevts_c); timing comes from vnmclip sound events"},
    "suspicion_radius_m": {"type": "number", "desc": "D5 shot-noise radius, design"}
  },
  "rows": [
