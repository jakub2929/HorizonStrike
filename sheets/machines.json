{
  "sheet": "machines",
  "version": 1,
  "key": "id",
  "desc": "v1 machines (BRIEF). hzd bindings: {hzd: <core path or brace pattern>[#<Type>.<member path>], fallback?}; member paths follow Ref<> links; [n] index, [Type] = first element of that type. The converter resolves into cache hzd/machines.json; the game uses fallback when a value is missing. TODO cells are owned by svet (_owner).",
  "columns": {
    "id": {"type": "string"},
    "display_name": {"type": "string"},
    "hzd_internal_name": {"type": "string", "desc": "folder name under models/characters/robots/ and entities/characters/robots/"},
    "entity": {"type": "string", "from": "hzd", "desc": "entity resource (core path)"},
    "model_parts": {"type": "list", "of": "string", "from": "hzd", "desc": "mesh parts; {a,b} = brace expansion of exact names"},
    "skeleton": {"type": "string", "from": "hzd"},
    "textures": {"type": "list", "of": "string", "from": "hzd", "desc": "TextureSet cores"},
    "destructibility": {"type": "string", "from": "hzd", "desc": "DestructibilityResource (health, parts with BoneName / DamageToEntityMultiplier)"},
    "ai": {"type": "string", "from": "hzd", "desc": "AIIndividualResource (Perception -> AIPerceptionResource.SensorSets)", "owner": "svet"},
    "spawn_setup": {"type": "string", "from": "hzd"},
    "sound_banks": {"type": "list", "of": "string", "from": "hzd"},
    "archetype": {"type": "enum", "values": ["guard", "herd"]},
    "hzd_health": {"type": "number", "from": "hzd", "desc": "HZD InitialHealth, informational (HZD damage scale differs from CS2); svet logs it in MODLOG", "owner": "svet"},
    "health": {"type": "number", "desc": "game HP in CS2 damage units (design)"},
    "armor_points": {"type": "number", "desc": "CS armor rule vs body hits (systems combat.armor_*); weak spots ignore armor"},
    "walk_speed_mps": {"type": "number"},
    "run_speed_mps": {"type": "number"},
    "turn_rate_dps": {"type": "number"},
    "sight_range_m": {"type": "number", "from": "hzd", "desc": "AIVisualSensor.DirectUnitDetectionDistance; game uses fallback if unresolved", "owner": "svet"},
    "sight_fov_deg": {"type": "number", "from": "hzd", "desc": "AIVisualSensor.DirectHeadingAngle (svet: confirm deg/rad and half/full angle)", "owner": "svet"},
    "peripheral_range_m": {"type": "number", "from": "hzd", "desc": "AIVisualSensor.PeripheralUnitDetectionDistance", "owner": "svet"},
    "hearing_range_m": {"type": "number", "from": "hzd", "desc": "AIAuralSensor.Range", "owner": "svet"},
    "immediate_suspicion_m": {"type": "number", "from": "hzd", "desc": "AISensorSetResource.UnitImmediateSuspicionDistance", "owner": "svet"},
    "immediate_alert_m": {"type": "number", "from": "hzd", "desc": "AISensorSetResource.UnitImmediateIdentificationDistance", "owner": "svet"},
    "suspicion_gain_per_s": {"type": "number", "desc": "see systems suspicion.visibility_formula"},
    "suspicion_decay_per_s": {"type": "number"},
    "suspicious_threshold": {"type": "number", "desc": "0..1; HZD EAlertLevel presence suspected"},
    "alert_threshold": {"type": "number", "desc": "0..1; HZD EAlertLevel threats identified"},
    "search_time_s": {"type": "number", "desc": "alert -> search -> back to idle"},
    "alert_call_radius_m": {"type": "number", "desc": "alerts other machines in radius; 0 = none (herds use systems suspicion.herd_alert_radius_m)"},
    "attacks": {"type": "ref", "ref": "machine_attacks", "list": true},
    "flee_on_alert": {"type": "bool"},
    "flee_distance_m": {"type": "number", "desc": "0 = never flees"},
    "fight_back_radius_m": {"type": "number", "desc": "fleeing machine attacks if the player is closer; 0 = never"},
    "herd_size_min": {"type": "int"},
    "herd_size_max": {"type": "int"},
    "weak_spot_parts": {"type": "list", "of": "string", "desc": "our names; meta.json maps them to bones/meshes"},
    "weak_spot_bones": {"type": "list", "of": "string", "from": "hzd", "owner": "svet", "desc": "DestructibilityPart.BoneName of the weak-spot parts"},
    "kill_reward_mult": {"type": "number", "desc": "D3"},
    "sound_roles": {"type": "list", "of": "string", "desc": "cache hzd/machines/<id>/snd/<role>_<n>; svet maps soundbank entries to roles"},
    "gait": {"type": "enum", "values": ["biped", "quadruped"]},
    "leg_count": {"type": "int"},
    "leg_chains": {"type": "list", "of": "string", "from": "hzd", "owner": "svet", "desc": "Skeleton.Joints names hip..foot per leg"},
    "stride_m": {"type": "number"},
    "step_height_m": {"type": "number"},
    "body_height_m": {"type": "number", "desc": "design estimate; meta.json height_m wins"}
  },
