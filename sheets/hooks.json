    {"id": "steam.cs2_manifest", "game": "steam", "kind": "read", "alias": "-", "path_or_pattern": "<lib>/steamapps/appmanifest_730.acf (= {game}/../../appmanifest_730.acf)", "owner": "cs2", "consumer": "manifest.json cs2_build, cache invalidation", "notes": "buildid 25815307 on this PC (updated 2026-10-09 ~14:15 from 25738536; only weapon_aug reload changed); preferred over game/csgo/steam.inf ClientVersion 2000930", "_verified": "*", "_evidence": {"path_or_pattern": "C:/Program Files (x86)/Steam/steamapps/appmanifest_730.acf"}},
    {"id": "melty.launch", "game": "melty", "kind": "launch-arg", "alias": "-", "path_or_pattern": "{managed}/HorizonStrike.exe --game {game}", "owner": "orchestrator", "consumer": "game boot", "notes": "{game} = folder containing game/csgo/pak01_dir.vpk", "_verified": "*", "_evidence": {"path_or_pattern": "docs/ARCHITECTURE.md, MODLOG D1"}},
