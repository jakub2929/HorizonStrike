{
  "sheet": "hooks",
  "version": 1,
  "key": "id",
  "desc": "Every point where the program touches CS2, HZD, Steam, Melty or the cache, and the converter protocol. <lib> = Steam library, {game} = CS2 folder from Melty, <hzd> = detected HZD folder.",
  "columns": {
    "id": {"type": "string"},
    "game": {"type": "enum", "values": ["cs2", "hzd", "steam", "melty", "cache", "hzs"]},
    "kind": {"type": "enum", "values": ["read", "launch-arg", "file-format", "protocol"]},
    "alias": {"type": "string", "desc": "prefix used in cs2 bindings (<alias>:<key path>); - = none"},
    "path_or_pattern": {"type": "string"},
    "owner": {"type": "enum", "values": ["cs2", "svet", "hra", "test", "orchestrator"]},
    "consumer": {"type": "string"},
    "notes": {"type": "string"}
  },
  "rows": [
    {"id": "steam.root", "game": "steam", "kind": "read", "alias": "-", "path_or_pattern": "HKCU/Software/Valve/Steam SteamPath, fallback C:/Program Files (x86)/Steam", "owner": "hra", "consumer": "game HZD detection", "notes": "registry read only", "_verified": "*", "_evidence": {"path_or_pattern": "docs/ARCHITECTURE.md"}},
