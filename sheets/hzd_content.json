{
  "sheet": "hzd_content",
  "version": 1,
  "key": "id",
  "desc": "HZD-specific paths and names the converter uses to find content in the player's install (D32: no HZD path or name literal in code). Owner svet. Values are format facts established from the data (see docs/notes/svet.md) or design picks.",
  "columns": {
    "id": {"type": "string", "desc": "<group>.<name>"},
    "group": {"type": "enum", "values": ["archive", "world", "terrain", "geometry", "campfires", "start", "sites", "vegetation", "machines", "audio", "materials"]},
    "value": {"type": "value", "desc": "string, number, list or object; the converter reads it through Hzs.Generated (HzdContentSheet)"},
    "desc": {"type": "string"}
  },
  "rows": [
    {"id": "archive.packs", "group": "archive", "value": ["DLC1", "FGRWin32", "Initial", "Remainder", "Patch"], "desc": "Packed_DX12/<name>.bin opened in this order; later archives override (Patch last); Initial and Remainder are required", "_verified": "*", "_evidence": {"value": "svet: MODLOG research; hzd-ls --stats"}},
    {"id": "archive.required", "group": "archive", "value": ["Initial", "Remainder"], "desc": "archives that must exist (the others are optional)", "_verified": "*", "_evidence": {"value": "svet: install listing"}},
    {"id": "archive.packed_dir", "group": "archive", "value": "Packed_DX12", "desc": "archive folder under the HZD install", "_verified": "*", "_evidence": {"value": "svet: install listing"}},
    {"id": "archive.oodle_dll", "group": "archive", "value": "oo2core_3_win64.dll", "desc": "Oodle library loaded in place from the HZD install (never copied)", "_verified": "*", "_evidence": {"value": "svet: CLAUDE.md"}},
    {"id": "archive.prefetch", "group": "archive", "value": "prefetch/fullgame.prefetch", "desc": "PrefetchList with the resource path list", "_verified": "*", "_evidence": {"value": "svet: S1: 146,891 paths"}},
    {"id": "archive.stream_prefix", "group": "archive", "value": "cache:", "desc": "prefix of data-source locations pointing at .core.stream files", "_verified": "*", "_evidence": {"value": "svet: S3 vertex/texture data sources"}},
    {"id": "world.root", "group": "world", "value": "levels/worlds/world", "desc": "main world (DLC1 world out of v1)", "_verified": "*", "_evidence": {"value": "svet: S1"}},
    {"id": "world.tile_dir", "group": "world", "value": "levels/worlds/world/tiles/tile_x{x}_y{y}", "desc": "tile folder; {x}/{y} = sign + 2 digits (x04, x-01)", "_verified": "*", "_evidence": {"value": "svet: S1 hzd-ls --tiles"}},
    {"id": "world.tile_terrain_marker", "group": "world", "value": "layers/terrain/terraintiledata", "desc": "tile-relative file whose presence marks a terrain tile (cell)", "_verified": "*", "_evidence": {"value": "svet: S1: 340 tiles"}},
    {"id": "terrain.height", "group": "terrain", "value": "worlddata/worlddata_height_terrain", "desc": "tile-relative WorldDataTextureMap with the 1024^2 R_UNORM_16 heights (m = raw/32)", "_verified": "*", "_evidence": {"value": "svet: S4"}},
    {"id": "terrain.albedo", "group": "terrain", "value": "worlddata/worlddata_flattened_albedo", "desc": "tile-relative terrain colour texture", "_verified": "*", "_evidence": {"value": "svet: S4"}},
    {"id": "geometry.layers_dir", "group": "geometry", "value": "layers/geometry/", "desc": "tile-relative folder of static geometry layer files", "_verified": "*", "_evidence": {"value": "svet: S6"}},
    {"id": "geometry.skip_layers", "group": "geometry", "value": ["cinematic", "skybox", "lighting", "autobot", "collision", "mockup", "temp_", "festival", "naming_ceremony", "_mq", "mq1_", "mq3_", "mq4_", "premq", "gate_closed", "_bsp", "_optimized"], "desc": "layer file names containing one of these are cinematic/quest/lighting dressing and are not placed", "_verified": "*", "_evidence": {"value": "svet: S6 tile 4,-3 layer review"}},
    {"id": "geometry.skip_mesh_names", "group": "geometry", "value": ["Shadow", "Occluder", "_occ_"], "desc": "mesh resources whose Name contains one of these are shadow / occluder chains (not visible geometry)", "_verified": "*", "_evidence": {"value": "svet: S6: *_ShadowLodChain, *_OccluderLodChain, *_ShadowGeo, ProxyShadowMesh*"}},
    {"id": "geometry.skip_prefixes", "group": "geometry", "value": ["generated_content/"], "desc": "mesh files under these prefixes are merged far-LOD proxies / baked copies", "_verified": "*", "_evidence": {"value": "svet: S6: 2131 of 2141 baked vegetation instances duplicate the hand-placed layer"}},
    {"id": "campfires.layer", "group": "campfires", "value": "layers/gameplay/campfires", "desc": "tile-relative layer with the campfire SceneInstances", "_verified": "*", "_evidence": {"value": "svet: S5"}},
    {"id": "campfires.prefab_match", "group": "campfires", "value": "campfire", "desc": "SceneInstance.Prefab path substring that marks a campfire", "_verified": "*", "_evidence": {"value": "svet: S5: scenes/campfire_save/scene_campfire_save_resource"}},
    {"id": "campfires.id_fallback", "group": "campfires", "value": "Campfire_x{x}_y{y}_i{i}", "desc": "id for a campfire SceneInstance without a Name", "_verified": "*", "_evidence": {"value": "svet: S5"}},
    {"id": "start.markers_layer", "group": "start", "value": "layers/gameplay/markers", "desc": "tile-relative layer with the named AIMarkers", "_verified": "*", "_evidence": {"value": "svet: S5"}},
    {"id": "start.marker", "group": "start", "value": "M_Area_Marketplace", "desc": "AIMarker of the start village centre (Mother's Heart) in the start cell", "_verified": "*", "_evidence": {"value": "svet: S5"}},
    {"id": "start.campfire_offset_m", "group": "start", "value": 3.0, "desc": "start position = this far from the start campfire towards the marker, on the terrain", "_verified": "*", "_evidence": {"value": "svet: design (S5)"}},
    {"id": "sites.layers_dir", "group": "sites", "value": "layers/scenes/", "desc": "tile-relative folder of scene layers", "_verified": "*", "_evidence": {"value": "svet: S6"}},
    {"id": "sites.folders", "group": "sites", "value": ["robot encounters/", "robot_encounters/", "robot_placement/"], "desc": "scene sub folders that hold fixed machine sites (worldencounters = random, skipped)", "_verified": "*", "_evidence": {"value": "svet: S6 hzd-sites: 80 site groups"}},
    {"id": "sites.layer_suffix", "group": "sites", "value": "layer", "desc": "site layer files end with this", "_verified": "*", "_evidence": {"value": "svet: S6"}},
    {"id": "sites.robot_spawnsetup_regex", "group": "sites", "value": "spawnsetups/robots/([a-z0-9_]+)/", "desc": "AIBehaviorGroupMember.SpawnSetup path -> original machine type (group 1)", "_verified": "*", "_evidence": {"value": "svet: S6"}},
    {"id": "vegetation.density", "group": "vegetation", "value": "worlddata/worlddata_placement_trees_blockbush_undergrowth_stealthplants", "desc": "tile-relative 512^2 RGBA density map", "_verified": "*", "_evidence": {"value": "svet: S6"}},
    {"id": "vegetation.placement", "group": "vegetation", "value": "placement", "desc": "tile-relative PlacementLayer file", "_verified": "*", "_evidence": {"value": "svet: S6"}},
    {"id": "vegetation.channels", "group": "vegetation", "value": ["trees", "blockbush", "undergrowth", "stealthplants"], "desc": "density map channels R, G, B, A (WorldDataTextureMapEntry names)", "_verified": "*", "_evidence": {"value": "svet: S6"}},
    {"id": "vegetation.placement_root", "group": "vegetation", "value": "placement_nodes", "desc": "second path segment of placement node resources (ecotopes/placement_nodes/<category>/...)", "_verified": "*", "_evidence": {"value": "svet: S6"}},
    {"id": "vegetation.category_channels", "group": "vegetation", "value": {"trees": "trees", "destructibles": "trees", "vision_blockers": "blockbush", "bushes": "blockbush", "shrubs": "blockbush", "ground_cover": "undergrowth", "grass": "undergrowth", "flowers": "undergrowth", "cover": "stealthplants", "stealth": "stealthplants"}, "desc": "placement node category folder -> density channel", "_verified": "*", "_evidence": {"value": "svet: S6 tile 4,-3 categories"}},
    {"id": "vegetation.species_per_channel", "group": "vegetation", "value": 6, "desc": "most used species kept per channel", "_verified": "*", "_evidence": {"value": "svet: design"}},
    {"id": "machines.anim_dir", "group": "machines", "value": "/animation/", "desc": "path segment of a machine model's animation folder (skeleton helpers live below it)", "_verified": "*", "_evidence": {"value": "svet: S3"}},
    {"id": "machines.helper_files_match", "group": "machines", "value": "helpers", "desc": "files under the animation folder containing this hold SkeletonHelpers", "_verified": "*", "_evidence": {"value": "svet: S3: robot_modelhelpers, skeletons/*_helpers"}},
    {"id": "machines.helper_suffix", "group": "machines", "value": "_helper", "desc": "helper joint suffix (lower case); a rigid part without a destructibility attachment uses the helper named like its mesh file", "_verified": "*", "_evidence": {"value": "svet: S3"}},
    {"id": "machines.variant_exclude", "group": "machines", "value": "Corrupt", "desc": "SkinnedModelResource names containing this are the corrupted variant (not used for the initial pose)", "_verified": "*", "_evidence": {"value": "svet: S3"}},
    {"id": "machines.sound_root", "group": "machines", "value": "sounds/effects/robots/{internal}/", "desc": "machine sound folder; {internal} = hzd_internal_name", "_verified": "*", "_evidence": {"value": "svet: S7"}},
    {"id": "machines.sound_dir_marker", "group": "machines", "value": "/wav/", "desc": "wave resources live in folders containing this", "_verified": "*", "_evidence": {"value": "svet: S7"}},
    {"id": "machines.sound_roles", "group": "machines", "value": {"idle": ["vox_idle", "idle_grunt", "idle_loop", "vox_snort", "horse_vox", "rndm_vox", "vox_grty", "chitter", "vox_borg"], "graze": ["grass_processor", "ripgrass", "procesing", "harvester_burp"], "scan": ["scan"], "suspicious": ["vox_susp", "vox_tst", "vox_a_", "start_whinney", "vox_rise", "vox_noise"], "alert": ["vox_alrt", "vox_alerted", "harvester_scream", "vox_b_", "jump_whine", "scout_call", "vox_speedup"], "attack": ["vox_attck", "vox_attack", "attkick", "attbackkick", "attack_", "pre_attack", "vox_agr", "bucking", "blade_drill", "back_swipe", "front_kick", "combat_charge", "swipe"], "hit": ["hit_react", "hit_pain_short", "hitmove", "hr_knockdown", "stumble", "hit_fall"], "death": ["kill", "pain_long", "malfunct", "death"], "footstep": ["footstep", "walk_dirt", "walk_grass", "step_extr", "fts_"]}, "desc": "sound role -> ordered wave-name substrings (first patterns win)", "_verified": "*", "_evidence": {"value": "svet: S7 wave name groups of scout/horse/harvester"}},
    {"id": "machines.sound_role_fallback", "group": "machines", "value": {"scan": "idle", "graze": "idle", "suspicious": "alert", "death": "hit"}, "desc": "role used when a role has no matching waves", "_verified": "*", "_evidence": {"value": "svet: S7"}},
    {"id": "machines.sounds_per_role", "group": "machines", "value": 6, "desc": "max waves exported per role", "_verified": "*", "_evidence": {"value": "svet: design"}},
    {"id": "audio.music", "group": "audio", "value": "sounds/music/world/world", "desc": "MusicResource with the world music echo bank", "_verified": "*", "_evidence": {"value": "svet: S7: 746 MP3 tracks"}},
    {"id": "audio.music_cues", "group": "audio", "value": {"explore_nora": {"exact": ["@audio.music_explore_track"]}, "explore_nora_2": {"exact": ["exploration_nora_03_full_pt01", "exploration_nora_03_full_pt02"]}, "combat": {"ends_with": ["robot_fight_v4-intro"], "family": "robot_fight_v4-high-", "order": "suffix", "max": 12}, "sneak": {"family": "robot_fight_v4-sneak", "order": "name"}}, "desc": "music cue -> tracks: exact names (@ = systems row), names ending with, then a family (name contains) ordered by the number after the last '-' (suffix) or by name, at most max", "_verified": "*", "_evidence": {"value": "svet: S7"}},
    {"id": "audio.cue_explore", "group": "audio", "value": "explore_nora", "desc": "cue the game plays while exploring (audio.json music_explore)", "_verified": "*", "_evidence": {"value": "svet: S7"}},
    {"id": "audio.cue_combat", "group": "audio", "value": "combat", "desc": "cue the game plays in combat (audio.json music_combat)", "_verified": "*", "_evidence": {"value": "svet: S7"}},
    {"id": "audio.ambience_kind", "group": "audio", "value": "birds", "desc": "kind / file prefix of the sounds taken from systems audio.ambience_track", "_verified": "*", "_evidence": {"value": "svet: S7"}},
    {"id": "audio.ambience_banks_max", "group": "audio", "value": 10, "desc": "EnvironmentSounds of systems audio.ambience_track used", "_verified": "*", "_evidence": {"value": "svet: design"}},
    {"id": "audio.ambience_per_bank", "group": "audio", "value": 2, "desc": "waves exported per ambience folder", "_verified": "*", "_evidence": {"value": "svet: design"}},
    {"id": "audio.ambience_min_seconds", "group": "audio", "value": 0.5, "desc": "shorter waves are skipped", "_verified": "*", "_evidence": {"value": "svet: design"}},
    {"id": "audio.ambience_extra", "group": "audio", "value": [{"folder": "sounds/effects/world/global/fire/fire_festivalcampfires/", "kind": "campfire"}], "desc": "extra ambience folders (campfire loop)", "_verified": "*", "_evidence": {"value": "svet: S7"}},
    {"id": "materials.tiers", "group": "materials", "value": ["models/", "shader_libraries/", "textures/"], "desc": "texture sources tried for base colour, in order (asset folder, shared shader libraries, texture library)", "_verified": "*", "_evidence": {"value": "svet: S6"}},
    {"id": "materials.never_base_color", "group": "materials", "value": ["detail", "noise", "pattern", "sparkle", "colorize", "anisoramp", "frost", "rain", "_msk", "_nmt", "/fx/"], "desc": "texture paths containing one of these are never used as base colour", "_verified": "*", "_evidence": {"value": "svet: S6"}},
