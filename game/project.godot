; Horizon Strike (working title) - Godot 4.7.2 project. See docs/ARCHITECTURE.md.

config_version=5

[application]

config/name="Horizon Strike"
config/description="Walk Horizon Zero Dawn's world with Counter-Strike 2 weapons. Converts content from your own installs."
run/main_scene="res://main/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"
boot_splash/show_image=false
boot_splash/bg_color=Color(0.05, 0.06, 0.08, 1)

[autoload]

Game="*res://core/game.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/aspect="expand"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=64

[rendering]

anti_aliasing/quality/msaa_3d=1
mesh_lod/lod_change/threshold_pixels=4.0
environment/defaults/default_clear_color=Color(0.55, 0.7, 0.85, 1)
